# ---- Storage ----
INSIGHTFORGE_DATA_DIR=./data
# Leave empty for SQLite in the data dir. Free Postgres (Neon/Supabase):
# DATABASE_URL=postgresql+psycopg://user:pass@host/db?sslmode=require
DATABASE_URL=
MAX_UPLOAD_MB=50
MAX_ROWS=1000000
DATASET_RETENTION_DAYS=30

# ---- Sandbox ----
SANDBOX_TIMEOUT_S=60
SANDBOX_MEMORY_MB=2048
# 1 = refuse to run code if a network namespace (unshare -rn) is unavailable
SANDBOX_REQUIRE_NETNS=0
RETRY_BUDGET=2

# ---- LLM (optional). Default "none" = fully deterministic, zero cost. ----
# none | ollama (free, local) | openai_compatible (e.g. free tiers of Groq/OpenRouter) | anthropic | openai (paid)
LLM_PROVIDER=none
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# Never send raw data rows to an external LLM unless set to 1
ALLOW_LLM_SAMPLE_ROWS=0

# ---- Accounts ----
# Comma-separated emails that become admins (the first registered user is always admin)
ADMIN_EMAILS=
# Set to 1 behind HTTPS in production
COOKIE_SECURE=0
CORS_ORIGINS=http://localhost:3000
